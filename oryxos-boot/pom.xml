        <!-- 27 节整机对账 IT（HumanTriggerFlowIT）：@Tag("integration") 默认跳过，需真 key 手动跑 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 025：PG 全链路 smoke 的嵌入式 PG（research R5：本机与 CI 同构、零外部依赖） -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.2.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!-- #453：reactor aggregate coverage HTML/XML + LINE COVEREDRATIO gate.
                 Skip when -DskipTests (install/package jobs): no Surefire data → 0% aggregate. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                    <!--
                      jacoco:check is BUNDLE-scoped to this module. Boot LINE is ~95% tip, so the
                      same floor as the aggregate gate is a non-regressing sanity check. The
                      authoritative reactor floor is scripts/jacoco-aggregate-line-gate.py below
                      (parses jacoco-aggregate/jacoco.xml LINE counters).
                    -->
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>jacoco-aggregate-line-gate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <executable>python3</executable>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <arguments>
                                <argument>${maven.multiModuleProjectDirectory}/scripts/jacoco-aggregate-line-gate.py</argument>
                                <argument>--xml</argument>
                                <argument>${project.build.directory}/site/jacoco-aggregate/jacoco.xml</argument>
                                <argument>--minimum</argument>
                                <argument>${jacoco.line.coverage.minimum}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.oryxos.cli.OryxOsCli</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
