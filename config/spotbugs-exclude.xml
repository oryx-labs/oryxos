<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs 4.10+ adds THROWS_METHOD_* and US_USELESS_SUPPRESSION_* detectors that
     flood the quality gate on existing intentional RuntimeException throws and
     historical @SuppressFBWarnings. Keep the engine bump; clean suppressions later. -->
<FindBugsFilter>
  <Match>
    <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
  </Match>
  <Match>
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
  </Match>
  <Match>
    <Bug pattern="US_USELESS_SUPPRESSION_ON_CLASS"/>
  </Match>
  <Match>
    <Bug pattern="US_USELESS_SUPPRESSION_ON_METHOD"/>
  </Match>
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>
</FindBugsFilter>
