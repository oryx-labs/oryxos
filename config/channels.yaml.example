# OryxOS 入站 IM 渠道配置示例（017 + 企微 + 钉钉）
# 复制到 .oryxos/channels.yaml 后按需修改；文件权限会被收紧为 rw-------。
# 凭证一律用 ${ENV_VAR} 占位从环境变量注入，禁止明文写入本文件。
# 一个条目 = 一个平台应用/机器人 = 绑定一个 Agent。
channels:
  - name: ops-feishu                    # 渠道名，唯一，[a-zA-Z0-9_-]+
    type: feishu                        # 飞书自建应用长连接
    app_id: ${FEISHU_APP_ID}
    app_secret: ${FEISHU_APP_SECRET}
    agent: ops-agent
    enabled: true

  # 企微智能机器人长连接（见 docs/WeComChannelSetup.md）
  # - name: ops-wecom
  #   type: wecom
  #   app_id: ${WECOM_BOT_ID}             # BotID
  #   app_secret: ${WECOM_BOT_SECRET}     # 长连接 Secret
  #   agent: ops-agent
  #   enabled: true

  # 钉钉机器人 Stream 长连接（见 docs/DingTalkChannelSetup.md）
  # - name: ops-dingtalk
  #   type: dingtalk
  #   app_id: ${DINGTALK_CLIENT_ID}       # ClientId（应用凭证）
  #   app_secret: ${DINGTALK_CLIENT_SECRET}
  #   agent: ops-agent
  #   enabled: true

  # Slack Socket Mode 长连接（见 docs/SlackChannelSetup.md）
  # - name: ops-slack
  #   type: slack
  #   app_id: ${SLACK_BOT_TOKEN}          # Bot User OAuth Token (xoxb-)
  #   app_secret: ${SLACK_APP_TOKEN}      # App-Level Token (xapp-，需 connections:write)
  #   agent: ops-agent
  #   enabled: true

  # Discord Gateway 长连接（见 docs/DiscordChannelSetup.md）
  # - name: ops-discord
  #   type: discord
  #   app_id: ${DISCORD_BOT_TOKEN}            # Bot Token
  #   app_secret: ${DISCORD_APPLICATION_ID}   # Application ID（频道 @Bot 匹配）
  #   agent: ops-agent
  #   enabled: true

  # Telegram Bot API 长轮询（见 docs/TelegramChannelSetup.md）
  # - name: ops-telegram
  #   type: telegram
  #   app_id: ${TELEGRAM_BOT_TOKEN}
  #   app_secret: ${TELEGRAM_BOT_USERNAME}    # 群 @Bot 匹配，可不带 @
  #   agent: ops-agent
  #   enabled: true

  # WhatsApp Cloud API webhook（见 docs/WhatsAppChannelSetup.md）
  # 回调：POST/GET /api/v1/channels/inbound/cs-whatsapp
  # - name: cs-whatsapp
  #   type: whatsapp
  #   app_id: ${WHATSAPP_ACCESS_TOKEN}
  #   app_secret: ${WHATSAPP_APP_SECRET}      # X-Hub-Signature-256
  #   agent: cs-agent
  #   extra:
  #     verify_token: ${WHATSAPP_VERIFY_TOKEN}
  #     phone_number_id: ${WHATSAPP_PHONE_NUMBER_ID}
  #   enabled: true

  # Microsoft Teams Azure Bot（见 docs/TeamsChannelSetup.md）
  # - name: ops-teams
  #   type: teams
  #   app_id: ${TEAMS_APP_ID}
  #   app_secret: ${TEAMS_APP_SECRET}
  #   agent: ops-agent
  #   extra:
  #     tenant_id: ${TEAMS_TENANT_ID}
  #   enabled: true

  # Google Chat HTTP 端点（见 docs/GoogleChatChannelSetup.md）
  # - name: ops-gchat
  #   type: gchat
  #   app_id: ${GCHAT_BOT_NAME}
  #   app_secret: ${GCHAT_ACCESS_TOKEN}
  #   agent: ops-agent
  #   enabled: true

  # Mattermost Outgoing Webhook（见 docs/MattermostChannelSetup.md）
  # - name: ops-mattermost
  #   type: mattermost
  #   app_id: ${MATTERMOST_BOT_USERNAME}
  #   app_secret: ${MATTERMOST_TOKEN}
  #   agent: ops-agent
  #   extra:
  #     base_url: ${MATTERMOST_BASE_URL}
  #     access_token: ${MATTERMOST_ACCESS_TOKEN}
  #   enabled: true

  # Matrix /sync 长轮询（见 docs/MatrixChannelSetup.md）
  # - name: ops-matrix
  #   type: matrix
  #   app_id: ${MATRIX_BOT_USER}              # @bot:homeserver
  #   app_secret: ${MATRIX_ACCESS_TOKEN}
  #   agent: ops-agent
  #   extra:
  #     homeserver: ${MATRIX_HOMESERVER}
  #   enabled: true

  # QQ 官方 Bot Gateway（见 docs/QqChannelSetup.md）
  # - name: ops-qq
  #   type: qq
  #   app_id: ${QQ_APP_ID}
  #   app_secret: ${QQ_APP_SECRET}
  #   agent: demo-agent
  #   enabled: true

  # 抖音经营私信 Webhook（见 docs/DouyinChannelSetup.md）
