# OryxOS 运行配置模板（外部 yaml）——复制成 config/application.yml 后填入真实 api-key。
#
# 用法：
#   cp config/application.yml.example config/application.yml
#   # 然后编辑 config/application.yml，把各 provider 的 api-key 填上
# 真实的 config/application.yml 已在 .gitignore（勿提交密钥）；start.sh 会自动加载它。
# 本 .example 不含任何真实凭证，随仓库提交，作为部署参考。
#
# 本文件铺开常用的「运行期默认」供部署时按机器调整；框架内部管道
# （spring.autoconfigure.exclude、jpa 方言、sql.init、management、springdoc）
# 不在此重复，继续从 jar 内置 application.yml 继承，避免与 jar 漂移。
# 注意：列表类键（file/shell/http、oryxos.providers）Spring 是整体替换不是合并——
# 在此覆盖时须与 jar 内置 application.yml 的对应列表保持一致，别只改一半造成两份分歧。

# ── 服务 ────────────────────────────────────────────────
server:
  port: 8080                    # HTTP API / 管理台端口（oryxos serve --port 可临时覆盖）
  # 反向代理（nginx/caddy 终止 TLS）下识别 X-Forwarded-Proto 等头，登录 cookie 才会带 Secure；
  # 直连部署无副作用（无 X-Forwarded-* 头时行为不变）。从 jar 内置默认继承，列此便于按需关闭。
  forward-headers-strategy: framework

# ── 持久化 / 并发 ───────────────────────────────────────
spring:
  datasource:
    url: jdbc:sqlite:oryxos.db  # SQLite 数据文件（会话 + 审计表），相对启动目录
    hikari:
      data-source-properties:
        journal_mode: WAL        # 允许读写并发，避免默认 rollback journal 放大锁竞争
        busy_timeout: 5000       # 短暂写锁时最多等待 5 秒，而不是立即报 database is locked
  threads:
    virtual:
      enabled: true             # 宪法七：Java 21 虚拟线程扛并发，不引入异步框架

# ── 向量化（015 起全局：知识与记忆同用一套）────────────────
# provider 按名引用上方 Provider 注册表（DeepSeek 无 embedding 端点；qwen 用 text-embedding-v4；
# zhipu 用 embedding-3；mock 提供确定性向量、无需 key）。不配 = 记忆纯关键词检索（行为与升级前一致）。
# 旧键 knowledge.embedding.* 仍被兼容回读（存量部署零改动）。
embedding:
  provider: mock
  model: ''
# embedding:
#   provider: zhipu
#   model: embedding-3

# ── 知识库（014）────────────────────────────────────────
# store：向量索引存储档（sqlite 默认 / memory 测试演示用）
knowledge:
  store: sqlite

# ── 长期记忆（22 节可插拔；015 三路检索升级）──────────────
# 使用方式 = 后端档（memory.backend）× 向量化（embedding.*）两个开关的组合：
#
#   backend    │ 未配 embedding.*            │ 已配 embedding.*
#   ───────────┼────────────────────────────┼──────────────────────────────────────
#   markdown   │ 关键词检索（升级前旧行为）  │ 三路融合：语义+关键词+时间新近（单机档）
#   sqlite     │ 关键词检索 + per-Agent 隔离 │ 三路融合 + per-Agent 隔离（分布式选它）
#   mem0       │ ——检索始终委托 mem0 的语义搜索，embedding.* 对这一档不参与——
#
# 已配 embedding.* 但服务临时不可用时自动降级为「关键词+时间」两路，结果尾行标注、恢复即回归；
# 写入永远先落本体再异步建索引，索引故障不丢记忆（启动自动对账补齐）。
# mem0 档需先起自托管服务：docker compose -f docker/mem0/compose.yaml up -d --build
# （LLM/embedder、维度对齐等见该文件头部注释），再设 MEM0_BASE_URL=http://localhost:8888。
memory:
  backend: markdown             # markdown（默认，零依赖）| sqlite（结构化）| mem0（自托管）
  recall:                       # 015：配置了 embedding.* 时生效的三路加权融合（语义+关键词+时间新近）
    top-k: 20                   # 融合后返回上限；未配置向量化时不生效（保持旧行为全量返回）
    weight:                     # 加权 RRF 系数，缺省等权；改配置即可调整、无需改码
      semantic: 1.0             # 语义命中偏弱时调大（如 2.0~3.0，旧记忆的语义命中更易登顶）
      keyword: 1.0
      recency: 1.0              # 时间新近权重，希望「新近优先」更明显时调大
  mem0:
    base-url: ${MEM0_BASE_URL:} # 仅 backend=mem0 时用；走环境变量不落明文
    user-id: ${MEM0_USER_ID:oryxos}
    api-key: ${MEM0_API_KEY:}   # 免鉴权自托管部署留空；配置时同发 Bearer 与 X-API-Key

# ── Sandbox 白名单（24 节，宪法六）：空列表 = deny-all，按最小权限收窄 ──
file:
  allowed_paths:
    - .oryxos                   # Agent 工作区（Profile / 记忆 / 技能 / 日志）
shell:
  allowed_commands:             # 解释器条目授予模型当前系统用户的代码执行权限，不提供隔离
    - ls
    - cat
    - echo
    - grep
    # 解释器（python/python3 等）不入默认白名单：bash -c 执行下是任意代码执行入口。
    # 确需跑脚本的 Agent 请在此显式加入并自担风险（如 GitHub 日报脚本）。
http:
  allowed_domains:
    - api.deepseek.com          # Provider 端点（精确匹配）
    - "*.feishu.cn"             # 飞书 webhook（通配真子域）
    - openws.work.weixin.qq.com # 企微智能机器人长连接
    - api.open-meteo.com        # 天气 Agent 免 key 天气源（31 节 Demo 一）
    - hn.algolia.com            # 科技日报 Agent 新闻源（31 节 Demo 二）
    - api.github.com            # GitHub 日报脚本子进程网络（31 节 Demo 三）
smtp:
  allowed_endpoints: []         # 邮件通知（EmailNotifyAdapter）出站 SMTP 端点白名单，格式 host[:port]
                                # （端口缺省=任意端口；空 = 不发任何邮件）。例：smtp.gmail.com:465

# ── 日志级别（格式 / appender 在 logback-spring.xml）──────
logging:
  level:
    root: INFO
    io.oryxos: DEBUG

# ── 工作区 + Provider 清单（宪法三显式映射；凭证勿提交）────
oryxos:
  # Agent 工作区根目录（可自定义路径与名字：agents/ memory/ logs/ mcp_servers.yaml 都在其下）。
  # 此 yaml 值对 serve/gateway 生效；轻命令（init/status/profile 不启动 Spring）改用环境变量
  # ORYXOS_ROOT（或 -Doryxos.root=）——设一个环境变量两边都认。改根后无需动 file.allowed_paths：
  # 运行时会把该根自动纳入文件白名单。
  root: .oryxos
  providers:
    - name: deepseek
      api-key: ""                # ← 填入你的 DeepSeek API Key（留空启动会点名报错）
      base-url: https://api.deepseek.com
    - name: codex
      api-key: ""                # ← 可选：填入 Codex / OpenAI API Key（不用可删掉本条）
      base-url: https://ai.soulecho.cc   # codex 中转代理；OryxOS 运行时走 /v1/chat/completions
    # 内置 mock provider：不连真实模型、无需 key，用于无 key 自测全链路。
    # 用它建/配一个 provider: mock 的 Agent，发一条"记住…"消息，即可在管理台看到
    # 会话/记忆/工具端点被填充（一次 save_memory 工具调用 + 两轮 ReAct）。生产可删。
    - name: mock
  # 「一句话生成 Agent 草稿」调 LLM 用的作者模型；provider 缺省取 providers 第一个
  author:
    provider: deepseek
    model: deepseek-v4-flash     # deepseek-chat 已废弃；可选 deepseek-v4-flash（快/省）| deepseek-v4-pro（强）
  # 管理台 Basic Auth（012-web-auth）。默认关=裸内网现状不变；
  # 开启后 /admin/** 需账密（/api/v1/** REST 不受影响）。
  # 开启前先跑 `oryxos user add <username>` 建账号，否则启动阻断。
  # web:
  #   auth:
  #     enabled: true
  #     realm: OryxOS
  # REST API Key 认证（018-rest-api-key）。默认关=现状不变；
  # 开启后 /api/v1/** 需请求头带 Key（`Authorization: Bearer <key>` 或 `X-API-Key: <key>`），
  # 豁免 /api/v1/health（探活）、/api/v1/auth/*（管理台登录）与 OPTIONS 预检；/admin/** 不受影响。
  # 开启前先跑 `oryxos apikey add <name>` 生成 Key（明文仅显示一次）；
  # 建议与上面的 auth 同时开启——否则管理台数据页无凭据可用（启动会告警）。
  # web:
  #   apikey:
  #     enabled: true
  # SSE 流式响应（019-sse-streaming）。消息端点带 Accept: text/event-stream 即流式返回，
  # 无需开关；heartbeat-seconds 为静默期心跳间隔（SSE 注释行，防代理空闲断连），默认 15。
  # web:
  #   sse:
  #     heartbeat-seconds: 15
